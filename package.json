{
  "name": "rodels-catering-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run tests/database.test.ts",
    "typecheck:edge": "npx --yes deno@2.9.6 check --config supabase/functions/deno.json supabase/functions/create-paymongo-checkout/index.ts supabase/functions/paymongo-webhook/index.ts supabase/functions/admin-set-role/index.ts supabase/functions/process-refund/index.ts supabase/functions/send-transactional-email/index.ts supabase/functions/public-assistant/index.ts",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "db:catalog": "node scripts/bundle-business-catalog.mjs && node scripts/bundle-sql.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.76.0",
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "vitest": "^5.0.4"
  }
}
